NODE_ENV=development
PORT=3000
SYSTEM_NAME=LENSEGUA
# Solo fuera de producción; NODE_ENV=production siempre bloquea introspección.
GRAPHQL_INTROSPECTION=true
# El explorador GraphQL está desactivado en todos los entornos.
TRUST_PROXY_HOPS=0
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
# Reemplace CHANGE_ME con la contraseña definida en infra/.env.
DATABASE_URL=postgresql://lensegua:CHANGE_ME@localhost:5434/lensegua
JWT_ACCESS_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
INITIAL_ADMIN_EMAIL=admin@example.local
INITIAL_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_TEMPORARY_PASSWORD
INITIAL_ADMIN_FIRST_NAME=Administrador
INITIAL_ADMIN_LAST_NAME=LENSEGUA
# Ruta fuera de src; puede ser absoluta o relativa a apps/api.
MEDIA_STORAGE_PATH=../../storage/media
