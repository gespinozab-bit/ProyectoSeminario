{
  "name": "@lensegua/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e:start": "tsx scripts/e2e-server.mjs",
    "e2e:verify": "node --test scripts/e2e-server.test.mjs",
    "graphql:examples": "node scripts/graphql-examples.mjs",
    "test:isolated": "tsx scripts/e2e-server.mjs --verify-project-tests",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "admin:reset": "tsx src/reset-admin.ts",
    "materials:import": "tsx src/import-materials.ts",
    "materials:export": "tsx src/export-materials.ts",
    "db:validate": "prisma validate",
    "test": "vitest run"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@lensegua/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "dotenv": "^17.2.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.0",
    "graphql": "^16.14.2",
    "helmet": "^8.1.0",
    "jose": "^6.2.12",
    "multer": "^2.5.0",
    "pg": "^8.23.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.1.1",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "vitest": "^5.0.1"
  }
}
