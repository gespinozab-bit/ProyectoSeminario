DOMAIN=lensegua.example.org
WEB_ORIGIN=https://lensegua.example.org
# Use a long random HEX password so it is safe inside the connection URL.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX_PASSWORD
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_REFRESH_SECRET_AT_LEAST_32_CHARACTERS
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_TEMPORARY_PASSWORD
INITIAL_ADMIN_FIRST_NAME=Administrador
INITIAL_ADMIN_LAST_NAME=LENSEGUA
# Empty means all host interfaces. Use 127.0.0.1 for an isolated local rehearsal.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
